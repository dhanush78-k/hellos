{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["email"]
    },
    "HealthEvent": {
      "title": "HealthEvent",
      "description": "User timeline health event",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 5000 },
        "documentName": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "title", "date", "type"]
    },
    "HealthDocument": {
      "title": "HealthDocument",
      "description": "User uploaded health document record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "maxLength": 100 },
        "size": { "type": "number" },
        "fileData": { "type": "string", "maxLength": 500000 },
        "notes": { "type": "string", "maxLength": 5000 },
        "uploadDate": { "type": "string", "maxLength": 50 },
        "extractedSummary": { "type": "string", "maxLength": 10000 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "name", "uploadDate"]
    },
    "Medication": {
      "title": "Medication",
      "description": "User tracked medication",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "dosage": { "type": "string", "maxLength": 100 },
        "frequency": { "type": "string", "maxLength": 100 },
        "startDate": { "type": "string", "maxLength": 50 },
        "endDate": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 5000 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "name", "dosage"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "User medical appointment",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "doctorName": { "type": "string", "maxLength": 150 },
        "specialty": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 50 },
        "time": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "maxLength": 50 },
        "prepNotes": { "type": "string", "maxLength": 10000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "doctorName", "date"]
    },
    "Goal": {
      "title": "Goal",
      "description": "User personal wellness goal",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "target": { "type": "string", "maxLength": 150 },
        "startDate": { "type": "string", "maxLength": 50 },
        "reminder": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "title"]
    },
    "AiConversation": {
      "title": "AiConversation",
      "description": "User chat history with HELIOS Copilot",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "title"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message in an AI conversation",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 20 },
        "content": { "type": "string", "maxLength": 20000 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "role", "content"]
    },
    "HealthSignal": {
      "title": "HealthSignal",
      "description": "Organizational reminders and alerts",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "type", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile documents"
    },
    "/users/{userId}/healthEvents/{eventId}": {
      "schema": { "$ref": "#/entities/HealthEvent" },
      "description": "User health events"
    },
    "/users/{userId}/documents/{documentId}": {
      "schema": { "$ref": "#/entities/HealthDocument" },
      "description": "User uploaded health documents"
    },
    "/users/{userId}/medications/{medicationId}": {
      "schema": { "$ref": "#/entities/Medication" },
      "description": "User medications"
    },
    "/users/{userId}/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "User appointments"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/Goal" },
      "description": "User wellness goals"
    },
    "/users/{userId}/aiConversations/{conversationId}": {
      "schema": { "$ref": "#/entities/AiConversation" },
      "description": "User AI conversations"
    },
    "/users/{userId}/aiConversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "User AI conversation messages"
    },
    "/users/{userId}/healthSignals/{signalId}": {
      "schema": { "$ref": "#/entities/HealthSignal" },
      "description": "User organizational health signals"
    }
  }
}
